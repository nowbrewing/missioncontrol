# Turso (same database as before)
ODB_TURSO_DATABASE_URL=
ODB_TURSO_AUTH_TOKEN=

# Optional: protect POST /api/admin/init in production
ADMIN_INIT_TOKEN=

# AI — pick one provider (Google is default)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Google ADK (Life Agent brain-dump bridge) — uses GEMINI_API_KEY; falls back to GOOGLE_GENERATIVE_AI_API_KEY if unset
# GEMINI_API_KEY=

# MongoDB Atlas (MCP save_tasks tool)
MONGODB_URI=

# openai (if Google project is blocked)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
