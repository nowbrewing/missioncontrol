# MongoDB Atlas
MONGODB_URI=mongodb+srv://missioncontrol:<db_password>@missioncontrol.ymn05d5.mongodb.net/?appName=missioncontrol
MONGODB_DB_NAME=missioncontrol

# Optional: protect POST /api/admin/init in production
ADMIN_INIT_TOKEN=

# --- Gemini via Vertex AI (recommended — higher quotas, GCP billing) ---
# Enable Vertex AI API + billing on your GCP project, then:
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Auth (pick one):
# Local: run `gcloud auth application-default login`
# Server/Vercel: paste service account JSON (Vertex AI User role) as one line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional model override (default: gemini-2.5-flash)
# GOOGLE_GENAI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- OR Gemini via AI Studio API key (free tier — low RPM, not recommended for check-in) ---
# GEMINI_API_KEY=

# MISSION_CONTROL_MCP_URL=https://your-deployment.vercel.app/api/mcp

# --- One-time Turso migration (only if importing legacy data) ---
# ODB_TURSO_DATABASE_URL=
# ODB_TURSO_AUTH_TOKEN=
